// Cloudflare deployment for the Arkhon bots. See README "Hosting on Cloudflare".
// `wrangler deploy` builds each bot's Dockerfile (bots/ops, bots/certa) with the repository root as build context,
// so Docker must be running on the machine that deploys.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arkhon-bots",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "OpsBot",
      "image": "../../bots/ops/Dockerfile",
      "image_build_context": "../..",
      // 1/4 vCPU, 1 GiB memory: room for discord.js, Prisma and the HTTP server.
      "instance_type": "basic",
      // Exactly one gateway connection; a second instance would answer every event twice.
      "max_instances": 1,
    },
    {
      "class_name": "CertaBot",
      "image": "../../bots/certa/Dockerfile",
      "image_build_context": "../..",
      // discord.js and Prisma only (no webhook server): the same small instance as the Ops bot.
      "instance_type": "basic",
      "max_instances": 1,
    },
  ],

  "durable_objects": {
    "bindings": [
      { "name": "OPS_BOT", "class_name": "OpsBot" },
      { "name": "CERTA_BOT", "class_name": "CertaBot" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OpsBot"] },
    { "tag": "v2", "new_sqlite_classes": ["CertaBot"] },
  ],

  // The bots' database (D1, created in the Cloudflare account). The bot applies
  // prisma/d1-migrations itself on startup.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arkhon-bots",
      "database_id": "4424b9b5-2dc2-4fa4-b41c-4c650b1f6f61",
    },
  ],

  // Starts the bot after deploys, crashes or platform restarts (it has no inbound traffic to wake it).
  "triggers": { "crons": ["*/5 * * * *"] },

  // No "vars" here: every bot setting is a Worker secret (wrangler secret put / secret bulk, or
  // synced from GitHub by .github/workflows/ci-deploy.yml). A name cannot be both a var and a secret.
}
