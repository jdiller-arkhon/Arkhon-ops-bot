{
  "name": "@arkhon/cloudflare",
  "private": true,
  "type": "module",
  "description": "Runs the Arkhon bots on Cloudflare Containers behind one Worker.",
  "scripts": {
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "types": "wrangler types --env-interface CloudflareBindings worker-configuration.d.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "typescript": "^5.9.3",
    "wrangler": "4.151.0"
  }
}
