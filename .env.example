# Copy to .env and fill in. Every ID is a Discord snowflake: enable Developer Mode in Discord
# (User Settings > Advanced), then right-click a channel/role > Copy ID.
# Empty values are treated as unset.

# ---------------------------------------------------------------- shared by all bots
NODE_ENV=development            # development | production (production deploys commands globally)
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace

# Local dev uses SQLite (file lands in prisma/.generated/). Docker Compose overrides this with Postgres.
DATABASE_URL=file:./dev.db
# DATABASE_URL=postgresql://arkhon:arkhon@localhost:5432/arkhon_bots?schema=public

# Used by docker-compose for the Postgres container
POSTGRES_USER=arkhon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=arkhon_bots

# ---------------------------------------------------------------- Ops bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# ---- Optional channel/role overrides
# Leave these empty: /setup server creates every channel and role and stores the ids in the database.
# Set one only to point the bot at a channel or role you made yourself (an env value wins).
SUPPORT_CHANNEL_ID=
TICKET_ARCHIVE_CHANNEL_ID=
START_HERE_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
FEEDBACK_FORUM_CHANNEL_ID=
CERTA_HOME_CHANNEL_ID=
ARGUS_HOME_CHANNEL_ID=
CERTA_STAFF_ROLE_ID=
ARGUS_STAFF_ROLE_ID=
CERTA_USER_ROLE_ID=
ARGUS_USER_ROLE_ID=

# Tickets: "thread" (private threads in #support, falls back to channels if unavailable) or "channel"
TICKET_MODE=thread
TICKET_CATEGORY_ID=             # optional: category for private ticket channels

# AutoMod
AUTOMOD_MENTION_LIMIT=5         # unique mentions per message before blocking (1-50)
AUTOMOD_KEYWORDS=               # comma-separated, Discord AutoMod wildcard syntax, e.g. free nitro,*scam*

# Release webhooks (HTTP server)
WEBHOOK_PORT=3000
RELEASE_WEBHOOK_SECRET=         # >= 16 chars. openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=          # required if GITHUB_RELEASE_REPOS is set
GITHUB_RELEASE_REPOS=           # e.g. certa=arkhon-industries/certa-app,argus=arkhon-industries/argus-app

# Member verification against arkhonindustries.com (see README "Member verification")
ARKHON_WEBSITE_URL=https://arkhonindustries.com
ARKHON_COMMUNITY_API_TOKEN=     # = the website's COMMUNITY_BOT_API_TOKEN (32+ chars). openssl rand -hex 32
MEMBER_WEBHOOK_SECRET=          # = the website's COMMUNITY_BOT_WEBHOOK_SECRET (32+ chars). openssl rand -hex 32

# Alt and raid shield
VERIFY_MIN_ACCOUNT_AGE_DAYS=7   # Discord accounts younger than this cannot verify (0 disables)
VERIFY_MAX_ATTEMPTS_PER_HOUR=5
RAID_JOIN_THRESHOLD=10          # this many joins...
RAID_JOIN_WINDOW_SECONDS=60     # ...within this window starts a lockdown
RAID_LOCKDOWN_MINUTES=30        # verification closed and invites paused for this long

# Feedback forum -> GitHub Issues
GITHUB_TOKEN=                   # fine-grained PAT with Issues: read & write on the feedback repos
GITHUB_FEEDBACK_REPOS=          # e.g. certa=arkhon-industries/certa-app,argus=arkhon-industries/argus-app
FEEDBACK_PROMOTE_EMOJI=🚀        # unicode emoji, or a custom emoji as <:name:id>
