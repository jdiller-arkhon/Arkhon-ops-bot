// Single schema shared by every Arkhon bot.
// Conventions:
//   - Models are prefixed with the bot that owns them (Ops*, Certa*, Argus*).
//   - Tables are mapped to "<bot>_<name>" so each bot's data is namespaced.
//   - No Prisma enums or native DB types: the same schema must run on SQLite (dev) and
//     PostgreSQL (prod). Status-like columns are strings validated in application code.
// The canonical provider is PostgreSQL. scripts/prisma.mjs rewrites the provider to SQLite
// when DATABASE_URL starts with "file:".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Ops bot

model OpsTicket {
  id                Int       @id @default(autoincrement())
  guildId           String
  product           String // "certa" | "argus"
  userId            String
  channelId         String?   @unique // thread or channel id, set once created
  channelKind       String    @default("thread") // "thread" | "channel"
  subject           String
  description       String
  appVersion        String?
  status            String    @default("open") // "open" | "waiting" | "closed"
  claimedById       String?
  closedById        String?
  createdAt         DateTime  @default(now())
  firstStaffReplyAt DateTime?
  closedAt          DateTime?

  @@index([product, status])
  @@index([userId, product, status])
  @@map("ops_tickets")
}

model OpsPanel {
  key       String   @id // "support" | "roles"
  channelId String
  messageId String
  updatedAt DateTime @updatedAt

  @@map("ops_panels")
}

// Discord resources created or adopted by /setup server, keyed by blueprint key
// ("role.certaStaff", "category.support", "channel.support", ...).
model OpsServerResource {
  key       String   @id
  kind      String // "role" | "category" | "channel"
  discordId String
  updatedAt DateTime @updatedAt

  @@map("ops_server_resources")
}

model OpsModAction {
  id              Int      @id @default(autoincrement())
  guildId         String
  targetId        String
  moderatorId     String
  action          String // "warn" | "timeout"
  reason          String
  durationMinutes Int?
  createdAt       DateTime @default(now())

  @@index([guildId, targetId])
  @@map("ops_mod_actions")
}

model OpsRelease {
  id        Int      @id @default(autoincrement())
  product   String
  version   String
  source    String // "webhook" | "github"
  messageId String?
  createdAt DateTime @default(now())

  @@unique([product, version])
  @@map("ops_releases")
}

model OpsFeedbackIssue {
  id           Int      @id @default(autoincrement())
  threadId     String   @unique
  product      String
  repo         String
  issueNumber  Int?
  issueUrl     String?
  promotedById String
  createdAt    DateTime @default(now())

  @@map("ops_feedback_issues")
}

// ---------------------------------------------------------------- Ops bot: member verification

// A Discord account verified against an Arkhon member ID (one-to-one on both sides).
model OpsMemberLink {
  discordUserId String   @id
  memberId      String   @unique
  accountRole   String? // role on arkhonindustries.com: client | pilot | admin
  linkedAt      DateTime
  updatedAt     DateTime @updatedAt

  @@map("ops_member_links")
}

// Audit trail for verification: started, linked, unlinked, failed and blocked attempts, lockdowns.
model OpsVerificationEvent {
  id            Int      @id @default(autoincrement())
  discordUserId String?
  memberId      String?
  type          String
  detail        String?
  actorId       String?
  createdAt     DateTime @default(now())

  @@index([discordUserId])
  @@index([memberId])
  @@map("ops_verification_events")
}

// Website webhook event ids already processed, so a replayed delivery is ignored.
model OpsWebhookEvent {
  id         String   @id
  receivedAt DateTime @default(now())

  @@map("ops_webhook_events")
}

// ---------------------------------------------------------------- Certa bot

// Discord account <-> Certa account. Never store certificate numbers or other government IDs.
model CertaLink {
  discordUserId    String   @id
  certaUserId      String   @unique
  displayName      String
  remindersEnabled Boolean  @default(true)
  linkedAt         DateTime @default(now())

  @@map("certa_links")
}

// Recurrent training reminders already sent, per due date, so none repeats. A new due date
// (training completed) starts a fresh cycle.
model CertaReminderSend {
  discordUserId String
  dueDate       String // YYYY-MM-DD
  thresholdDays Int
  sentAt        DateTime @default(now())

  @@id([discordUserId, dueDate, thresholdDays])
  @@map("certa_reminder_sends")
}

// Public summary of a logged flight, kept so "Share to #flight-logs" can post it later.
// Location is already coarsened (no coordinates or street addresses); notes are never stored.
model CertaSharedFlight {
  flightId        String    @id
  discordUserId   String
  date            String // YYYY-MM-DD
  publicLocation  String
  aircraft        String
  durationMinutes Int
  missionType     String
  sharedAt        DateTime?
  createdAt       DateTime  @default(now())

  @@index([discordUserId])
  @@map("certa_shared_flights")
}

// Scheduled job occurrences already run ("recurrent-reminders" + "2026-10-15"), across restarts.
model CertaJobRun {
  job    String
  runKey String
  ranAt  DateTime @default(now())

  @@id([job, runKey])
  @@map("certa_job_runs")
}

// ---------------------------------------------------------------- Certa bot: mock Certa backend
// Used only with CERTA_API_MODE=mock, until the Certa API exposes the bot endpoints.

model CertaMockUser {
  certaUserId      String   @id
  displayName      String
  lastTrainingDate String? // YYYY-MM-DD
  lastTrainingKind String? // "initial" | "recurrent"
  createdAt        DateTime @default(now())

  @@map("certa_mock_users")
}

model CertaMockLinkCode {
  code          String   @id
  certaUserId   String
  discordUserId String
  redeemedAt    DateTime @default(now())

  @@map("certa_mock_link_codes")
}

model CertaMockFlight {
  flightId        String   @id
  certaUserId     String
  date            String // YYYY-MM-DD
  location        String
  locationIsIcao  Boolean
  aircraft        String
  durationMinutes Int
  missionType     String
  notes           String?
  createdAt       DateTime @default(now())

  @@index([certaUserId, date])
  @@index([date])
  @@map("certa_mock_flights")
}
