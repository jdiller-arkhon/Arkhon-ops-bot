{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["development"],
    "types": ["node"]
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "bots/*/src",
    "bots/*/test",
    "deploy/*/test",
    "deploy/*/scripts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
